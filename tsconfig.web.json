{
  "extends": "./tsconfig.json",
  "include": ["src/renderer/src/**/*", "src/shared/**/*", "src/preload/api.d.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "outDir": "dist/web-typecheck"
  }
}
